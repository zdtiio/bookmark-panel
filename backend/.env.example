# 服务端口
PORT=3000

# JWT 密钥：必须至少 32 位随机字符，且不能使用这里的示例值。
# 服务启动时会校验，弱密钥将直接拒绝启动。
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-secret-key-here-must-be-at-least-32-characters

# JWT 有效期
JWT_EXPIRES_IN=7d

# 运行环境：development / production
NODE_ENV=development

# SQLite 数据库路径
DB_PATH=./database/bookmarks.db

# 上传目录（图标文件）
UPLOAD_PATH=./uploads

# CORS 白名单：逗号分隔的允许来源（含协议与端口）。
# 留空表示只允许同源访问；插件与 curl 等无 Origin 的请求不受影响。
# 示例：CORS_ORIGINS=http://localhost:5173,https://bookmarks.example.com
CORS_ORIGINS=

# 是否信任反向代理的 X-Forwarded-For（只有在确实部署于反代之后才设为 true，
# 否则攻击者可以伪造该头绕过登录限流）
TRUST_PROXY=false

# 生产环境是否下发 HSTS（仅在 HTTPS 部署时开启）
ENABLE_HSTS=false
